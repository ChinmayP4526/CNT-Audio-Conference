{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Audio Conference (FastAPI Server)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Run UDP Echo Server (Port 9999)",
            "type": "debugpy",
            "request": "launch",
            "module": "udp_service.server",
            "args": [
                "--host",
                "0.0.0.0",
                "--port",
                "9999"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run UDP Probe Monitor",
            "type": "debugpy",
            "request": "launch",
            "module": "udp_service.monitor",
            "args": [
                "--host",
                "127.0.0.1",
                "--port",
                "9999",
                "--count",
                "100",
                "--interval",
                "0.1",
                "--room",
                "CNT101"
            ],
            "console": "integratedTerminal"
        }
    ]
}
